<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorControlHighlight">#33FFFFFF</item>
        <item name="android:windowBackground">@drawable/bg_screen</item>
        <item name="android:textColorPrimary">@color/screen_text</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:buttonStyle">@style/PillButton</item>
    </style>

    <style name="PillButton" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:background">@drawable/btn_pill</item>
        <item name="android:textColor">@color/btn_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">22dp</item>
        <item name="android:paddingRight">22dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
