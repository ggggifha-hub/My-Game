<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#FF131F38" />
            <stroke android:width="1dp" android:color="#FF24344F" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_fill_pressed" />
            <stroke android:width="1.5dp" android:color="@color/accent" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#FF1E3356" android:endColor="#FF16284A" />
            <stroke android:width="1.5dp" android:color="@color/btn_stroke" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
